   "bodies": {
    "runXp6": "function runXp6(v){G.xp+=v;}",
    "runLvlUp6": "function runLvlUp6(p){while(G.xp>=G.need&&p.hp>0){G.xp-=G.need;G.lvl++;G.need=need(G.lvl);G.lvlQ++;}}",
    "runLvlSeg6": "function runLvlSeg6(){G.lvlQ++;G.xp=0;G.lvl++;G.need=need(G.lvl);}",
    "runBrief6": "function runBrief6(K){Object.assign(G,{lvl:1+K,xp:0,lvlQ:K,briefQ:K,briefN:K});G.need=need(G.lvl);}",
    "runStart6": "function runStart6(lv){Object.assign(G,{xp:0,lvl:lv,lvlQ:0,bpQ:0});G.need=need(lv);}",
    "runZero6": "function runZero6(bp){const n=need(1);G.lvl=1;G.xp=0;G.need=n;G.lvlQ=0;if(bp)G.bpQ=0;G.briefQ=0;}",
    "runRestore6": "function runRestore6(r){G.xp=r.xp;G.lvl=r.lvl;G.need=r.need;G.lvlQ=0;G.bpQ=0;}",
    "runGrant6": "function runGrant6(k){if(k==='bp')G.bpQ++;else G.lvlQ++;}",
    "runTake6": "function runTake6(k){if(k==='bp')G.bpQ=Math.max(0,G.bpQ-1);else{G.lvlQ=Math.max(0,G.lvlQ-1);if(G.briefQ>0)G.briefQ--;}}",
    "runQClear6": "function runQClear6(){G.lvlQ=0;G.briefQ=0;}"
   }
